---
import SongResultsList from "./home/SongResultsList"

const { song } = Astro.props
const excerpts = song.excerpts || []
---

{
  excerpts.map((excerpt) => {
    const sourceExcerpts = excerpt.source?.excerpts || []
    const relatedSongs = sourceExcerpts
      .flatMap((sourceExcerpt) => sourceExcerpt.songs || [])
      .filter(
        (relatedSong, index, songs) =>
          relatedSong.slug !== song.slug &&
          songs.findIndex(
            (candidate) => candidate.slug === relatedSong.slug,
          ) === index,
      )

    return (
      <section class="mt-10">
        <div class="max-w-2xl rounded-md bg-primary-50 p-6 text-slate-900 sm:p-8">
          {sourceExcerpts.map((sourceExcerpt) => (
            <div class="mt-6 first:mt-0">
              {sourceExcerpt.language?.nameEn && (
                <div class="mb-2 text-sm font-medium text-primary-800">
                  {sourceExcerpt.language.nameEn}
                </div>
              )}
              {sourceExcerpt.text && (
                <blockquote class="space-y-3 text-lg leading-8">
                  {sourceExcerpt.text.split("  ").map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </blockquote>
              )}
            </div>
          ))}
          <div class="mt-8 flex flex-wrap justify-between gap-3 text-sm text-slate-700">
            <span>{excerpt.source?.author}</span>
            <span>{excerpt.source?.description}</span>
          </div>
        </div>

        {relatedSongs.length > 0 && (
          <div class="mt-8">
            <h2 class="text-lg font-semibold text-slate-950">Related songs</h2>
            <div class="mt-3">
              <SongResultsList songs={relatedSongs} />
            </div>
          </div>
        )}
      </section>
    )
  })
}
