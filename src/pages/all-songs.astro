---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="All Songs" pathname="/all-songs">
  <meta http-equiv="refresh" content="0; url=/#songs" slot="head" />
  <div class="mx-auto mt-8 max-w-4xl px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold leading-tight text-slate-950">
      All Songs
    </h1>
    <p class="mt-4 text-slate-700">
      The searchable song list now lives on the homepage.
    </p>
    <a
      href="/#songs"
      class="mt-6 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground no-underline hover:bg-primary/90"
    >
      Open song search
    </a>
  </div>
</BaseLayout>
