---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="Page not found" pathname="/404">
  <div class="mx-auto mt-8 max-w-4xl px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold leading-tight text-slate-950">
      Page not found
    </h1>
    <p class="mt-4 text-slate-700">
      Try using the <a href="/#songs">song search</a>. If you think this page
      should exist, <a href="/contact">tell us</a>.
    </p>
  </div>
</BaseLayout>
