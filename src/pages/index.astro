---
import SongFinder from "../components/home/SongFinder"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getSongsForListViews } from "../lib/songs.mjs"

const allSongs = await getSongsForListViews()
const image = {
  src: "/meta.png",
  width: 1200,
  height: 628,
}
const finderSongs = allSongs.map((song) => ({
  title: song.title,
  slug: song.slug,
  description: song.description,
  music: song.music,
  words: song.words,
  publishedAt: song.publishedAt,
  contributors: song.contributors,
  languages: song.languages,
  tags: song.tags,
}))
---

<BaseLayout image={image}>
  <section
    class="mx-auto mt-12 max-w-5xl px-4 sm:mt-16 sm:px-6 lg:mt-20 lg:px-8"
  >
    <div class="max-w-3xl">
      <h1
        class="text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl md:text-6xl"
      >
        Learn and listen to <span class="text-primary-700">Bahá'í songs</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700 md:text-xl">
        Find your favorite song, learn how to play with lyrics, chords and
        videos, and sing with your community.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#songs"
          class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-medium text-primary-foreground no-underline hover:bg-primary/90"
        >
          Search songs
        </a>
        <a
          href="/collections"
          class="inline-flex items-center justify-center rounded-md bg-secondary px-6 py-3 text-base font-medium text-secondary-foreground no-underline hover:bg-secondary/80"
        >
          Curated collections
        </a>
      </div>
      <div class="mt-10 max-w-2xl border-t border-slate-200 pt-6">
        <h2 class="text-base font-semibold text-slate-950">
          Try the new Songbook
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-700">
          Find songs faster, transpose chords, and switch between guitar and
          ukulele diagrams. Each song page includes lyrics and chords, no PDF
          download required.
        </p>
        <a
          href="https://songbook.bahaisongs.com"
          class="mt-3 inline-flex items-center justify-center rounded-md border border-primary-200 bg-white px-3 py-1.5 text-sm font-medium text-primary-700 no-underline hover:bg-primary-50"
        >
          Open Songbook
        </a>
      </div>
    </div>
  </section>

  <SongFinder songs={finderSongs} client:load />
</BaseLayout>
