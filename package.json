{
  "name": "bahai-song-project-website",
  "description": "bahá'í song project website",
  "version": "0.1.0",
  "author": "Dayyan Smith <dayyan.smith@gmail.com>",
  "keywords": [
    "bahai",
    "music",
    "songs",
    "videos",
    "chords"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "yarn": "1.x"
  },
  "scripts": {
    "analyze:prettier": "prettier --list-different \"**/*.{astro,css,js,jsx,json,md,mdx,ts,tsx}\"",
    "analyze": "yarn analyze:prettier",
    "fix:prettier": "prettier --write \"**/*.{astro,css,js,jsx,json,md,mdx,ts,tsx}\"",
    "fix": "yarn fix:prettier",
    "build": "astro build",
    "dev": "astro dev",
    "develop": "yarn dev",
    "preview": "astro preview",
    "serve": "yarn preview",
    "clean": "rm -rf dist .astro",
    "test": "yarn build"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.5.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bahaisongproject/bsp-website/"
  },
  "bugs": {
    "url": "https://github.com/bahaisongproject/bsp-website/issues"
  }
}
